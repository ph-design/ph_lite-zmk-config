#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/ot60-haptics.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define FN 1

/ {
    behaviors {
        ot60_hap: ot60-haptics {
            compatible = "phdesign,ot60-haptics";
            #binding-cells = <1>;
            display-name = "Haptic Click";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp N1   &kp N2   &kp N3    &kp N4  &kp N5  &kp MINUS &kp EQUAL &kp N6  &kp N7   &kp N8   &kp N9  &kp N0    &kp DEL
                &kp TAB   &kp Q    &kp W    &kp E     &kp R   &kp T   &kp LBKT  &kp RBKT  &kp Y   &kp U    &kp I    &kp O   &kp P     &kp BSPC
                &kp LCTRL &kp A    &kp S    &kp D     &kp F   &kp G   &kp BSLH  &kp SQT   &kp H   &kp J    &kp K    &kp L   &kp SEMI  &kp RET
                &kp LSHFT &kp Z    &kp X    &kp C     &kp V   &kp B   &kp LEFT  &kp RIGHT  &kp N   &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &kp LGUI &kp LALT &kp SPACE                &mo FN               &kp SPACE        &kp RALT &kp RGUI &kp LC(LS(LA(LGUI)))
            >;
        };

        function {
            display-name = "Function";
            bindings = <
                &kp GRAVE   &kp F1      &kp F2      &kp F3      &kp F4      &kp F5    &ot60_hap OT60_LRA_LEFT &ot60_hap OT60_LRA_RIGHT &kp F6 &kp F7  &kp F8  &kp F9   &kp F10   &kp F12
                &out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &ot60_hap OT60_LRA_BOTH &bootloader &kp PG_UP &kp HOME &kp UP &kp END &kp F11 &studio_unlock
                &trans      &trans       &trans       &trans       &rgb_ug RGB_TOG &trans &trans &trans &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &trans &soft_off
                &trans      &trans       &trans       &rgb_ug RGB_BRD &rgb_ug RGB_BRI &bt BT_CLR &trans &trans &trans &trans &trans &trans &trans &trans
                &trans      &trans       &trans       &trans       &trans  &trans   &trans    &trans  &trans
            >;
        };
    };
};
