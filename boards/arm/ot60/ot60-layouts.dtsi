/*
 * OT60 PCB 1.0 (7fbe800), checked against the KiCad PCB and KLE layout.
 * Include from an nRF52840 board DTS. Positions are in keymap order.
 */
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &ot60_kscan;
        zmk,physical-layout = &ot60_layout;
    };

    ot60_kscan: ot60-kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios =
            <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios =
            <&gpio0 20 GPIO_ACTIVE_HIGH>,
            <&gpio0 22 GPIO_ACTIVE_HIGH>,
            <&gpio0 24 GPIO_ACTIVE_HIGH>,
            <&gpio1  0 GPIO_ACTIVE_HIGH>,
            <&gpio0 19 GPIO_ACTIVE_HIGH>,
            <&gpio0 21 GPIO_ACTIVE_HIGH>,
            <&gpio0 23 GPIO_ACTIVE_HIGH>,
            <&gpio0 25 GPIO_ACTIVE_HIGH>,
            <&gpio0 26 GPIO_ACTIVE_HIGH>,
            <&gpio0  4 GPIO_ACTIVE_HIGH>,
            <&gpio0  6 GPIO_ACTIVE_HIGH>,
            <&gpio0  8 GPIO_ACTIVE_HIGH>,
            <&gpio1  9 GPIO_ACTIVE_HIGH>,
            <&gpio0 12 GPIO_ACTIVE_HIGH>;
    };

    ot60_transform: ot60-transform {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <14>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
            RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)

            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)
            RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)

            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)
            RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)

            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)
            RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)

            RC(4,0) RC(4,1) RC(4,3) RC(4,5) RC(4,7) RC(4,9) RC(4,11)
            RC(4,12) RC(4,13)
        >;
    };

    ot60_layout: ot60-layout {
        compatible = "zmk,physical-layout";
        display-name = "OT60";
        kscan = <&ot60_kscan>;
        transform = <&ot60_transform>;

        /* Width, height, x, y, rotation, rotation origin x/y. */
        keys =
            <&key_physical_attrs 150 100    0   0 0 0 0>,
            <&key_physical_attrs 100 100  150   0 0 0 0>,
            <&key_physical_attrs 100 100  250   0 0 0 0>,
            <&key_physical_attrs 100 100  350   0 0 0 0>,
            <&key_physical_attrs 100 100  450   0 0 0 0>,
            <&key_physical_attrs 100 100  550   0 0 0 0>,
            <&key_physical_attrs 100 100  650   0 0 0 0>,
            <&key_physical_attrs 100 100  750   0 0 0 0>,
            <&key_physical_attrs 100 100  850   0 0 0 0>,
            <&key_physical_attrs 100 100  950   0 0 0 0>,
            <&key_physical_attrs 100 100 1050   0 0 0 0>,
            <&key_physical_attrs 100 100 1150   0 0 0 0>,
            <&key_physical_attrs 100 100 1250   0 0 0 0>,
            <&key_physical_attrs 150 100 1350   0 0 0 0>,

            <&key_physical_attrs 150 100    0 100 0 0 0>,
            <&key_physical_attrs 100 100  150 100 0 0 0>,
            <&key_physical_attrs 100 100  250 100 0 0 0>,
            <&key_physical_attrs 100 100  350 100 0 0 0>,
            <&key_physical_attrs 100 100  450 100 0 0 0>,
            <&key_physical_attrs 100 100  550 100 0 0 0>,
            <&key_physical_attrs 100 100  650 100 0 0 0>,
            <&key_physical_attrs 100 100  750 100 0 0 0>,
            <&key_physical_attrs 100 100  850 100 0 0 0>,
            <&key_physical_attrs 100 100  950 100 0 0 0>,
            <&key_physical_attrs 100 100 1050 100 0 0 0>,
            <&key_physical_attrs 100 100 1150 100 0 0 0>,
            <&key_physical_attrs 100 100 1250 100 0 0 0>,
            <&key_physical_attrs 150 100 1350 100 0 0 0>,

            <&key_physical_attrs 150 100    0 200 0 0 0>,
            <&key_physical_attrs 100 100  150 200 0 0 0>,
            <&key_physical_attrs 100 100  250 200 0 0 0>,
            <&key_physical_attrs 100 100  350 200 0 0 0>,
            <&key_physical_attrs 100 100  450 200 0 0 0>,
            <&key_physical_attrs 100 100  550 200 0 0 0>,
            <&key_physical_attrs 100 100  650 200 0 0 0>,
            <&key_physical_attrs 100 100  750 200 0 0 0>,
            <&key_physical_attrs 100 100  850 200 0 0 0>,
            <&key_physical_attrs 100 100  950 200 0 0 0>,
            <&key_physical_attrs 100 100 1050 200 0 0 0>,
            <&key_physical_attrs 100 100 1150 200 0 0 0>,
            <&key_physical_attrs 100 100 1250 200 0 0 0>,
            <&key_physical_attrs 150 100 1350 200 0 0 0>,

            <&key_physical_attrs 150 100    0 300 0 0 0>,
            <&key_physical_attrs 100 100  150 300 0 0 0>,
            <&key_physical_attrs 100 100  250 300 0 0 0>,
            <&key_physical_attrs 100 100  350 300 0 0 0>,
            <&key_physical_attrs 100 100  450 300 0 0 0>,
            <&key_physical_attrs 100 100  550 300 0 0 0>,
            <&key_physical_attrs 100 100  650 300 0 0 0>,
            <&key_physical_attrs 100 100  750 300 0 0 0>,
            <&key_physical_attrs 100 100  850 300 0 0 0>,
            <&key_physical_attrs 100 100  950 300 0 0 0>,
            <&key_physical_attrs 100 100 1050 300 0 0 0>,
            <&key_physical_attrs 100 100 1150 300 0 0 0>,
            <&key_physical_attrs 100 100 1250 300 0 0 0>,
            <&key_physical_attrs 150 100 1350 300 0 0 0>,

            <&key_physical_attrs 150 100    0 400 0 0 0>,
            <&key_physical_attrs 150 100  150 400 0 0 0>,
            <&key_physical_attrs 150 100  300 400 0 0 0>,
            <&key_physical_attrs 200 100  450 400 0 0 0>,
            <&key_physical_attrs 200 100  650 400 0 0 0>,
            <&key_physical_attrs 200 100  850 400 0 0 0>,
            <&key_physical_attrs 150 100 1050 400 0 0 0>,
            <&key_physical_attrs 150 100 1200 400 0 0 0>,
            <&key_physical_attrs 150 100 1350 400 0 0 0>;
    };
};
