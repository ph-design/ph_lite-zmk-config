if BOARD_PH_LITE

config BOARD
    default "ph_lite"

if USB_DEVICE_STACK

config USB_NRFX
    default y

config USB_DEVICE_VID
    default 0x5048

config USB_DEVICE_PID
    default 0xFF00

config USB_DEVICE_MANUFACTURER
    default "Team PHDesign"

endif # USB_DEVICE_STACK

config BT_CTLR
    default BT

# Zephyr 3.5 requires the WS2812 driver to be selected explicitly.
config WS2812_STRIP
    default y if SHIELD_PH60_SC_V2_EVO

endif # BOARD_PH_LITE
