#include "PH60-SC_V2.dtsi"
#include <dt-bindings/led/led.h>
#include <dt-bindings/gpio/nordic-nrf-gpio.h>

&pinctrl {
	spi1_default: spi1_default {
		group1 {
				psels = <NRF_PSEL(SPIM_MOSI, 1, 2) NRF_PSEL(SPIM_SCK, 1, 3)>;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
				psels = <NRF_PSEL(SPIM_MOSI, 1, 2) NRF_PSEL(SPIM_SCK, 1, 3)>;
			low-power-enable;
		};
	};
};

/*
 * P1.11 / P1.12 / P1.14 driven high as plain push-pull GPIO outputs.
 * H0H1 = high drive on both levels, so each pin can actually source load
 * current (min 6 mA @ 3.3 V) instead of the ~1-4 mA standard drive.
 * Configured by the Zephyr GPIO hog mechanism (CONFIG_GPIO_HOGS) at
 * POST_KERNEL init, so they are high before any ZMK code runs.
 */
&gpio1 {
	out_high_hog: out-high-hog {
		gpio-hog;
		gpios = <11 (GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H0H1)>
		      , <12 (GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H0H1)>
		      , <14 (GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H0H1)>
		      ;
		output-high;
		line-name = "out_high";
	};
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";

	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";

		/* SPI */
		reg = <0>; /* ignored, but necessary for SPI bindings */
		spi-max-frequency = <4000000>;

		/* WS2812 */
		chain-length = <61>; /* 61 keys, each with one RGB LED */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
	};
};

/ {
	chosen {
		zmk,battery = &vddh;
		zmk,underglow = &led_strip;
		zmk,ext-power = &rgb_power;
		zmk,studio-rpc-uart = &snippet_studio_rpc_usb_uart;
	};

	vddh: vddh {
		compatible = "zmk,battery-nrf-vddh";
	};

	rgb_power: ext-power {
		compatible = "zmk,ext-power-generic";
		label = "EXT_POWER";
		status = "okay";
		init-delay-ms = <50>;
		control-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
	};

	keys {
		compatible = "gpio-keys";
		wakeup_key: wakeup_key {
			gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // Row 2
		};
	};

	wakeup_scan: wakeup_scan {
		compatible = "zmk,gpio-key-wakeup-trigger";
		trigger = <&wakeup_key>;
		wakeup-source;
		extra-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;  // Column 12
	};

	soft_off_wakers {
		compatible = "zmk,soft-off-wakeup-sources";
		wakeup-sources = <&wakeup_scan>;
	};
};

&zephyr_udc0 {
	snippet_studio_rpc_usb_uart: snippet_studio_rpc_usb_uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};


