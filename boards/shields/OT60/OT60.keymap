#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include "OT60-rgb.dtsi"

/ {
    behaviors {
        haptic: haptic {
            compatible = "phdesign,behavior-ot60-haptic";
            #binding-cells = <1>;
            display-name = "Right haptic";
        };
        haptic_play: haptic_play {
            compatible = "phdesign,behavior-ot60-haptic-play";
            #binding-cells = <1>;
            display-name = "Right haptic effect";
        };
        ht_user1: ht_user1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        ht_user2: ht_user2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_reserved_0 {
            reserved;
            key-positions = <0 1>;
            bindings = <&none>;
            timeout-ms = <50>;
        };
        combo_reserved_1 {
            reserved;
            key-positions = <0 1>;
            bindings = <&none>;
            timeout-ms = <50>;
        };
        combo_reserved_2 {
            reserved;
            key-positions = <0 1>;
            bindings = <&none>;
            timeout-ms = <50>;
        };
        combo_reserved_3 {
            reserved;
            key-positions = <0 1>;
            bindings = <&none>;
            timeout-ms = <50>;
        };
        combo_reserved_4 {
            reserved;
            key-positions = <0 1>;
            bindings = <&none>;
            timeout-ms = <50>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "Base";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp LBKT  &kp RBKT  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DEL
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp MINUS  &kp EQUAL  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp SQT  &kp BSLH  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp RET
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp HOME  &kp END  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &kp RSHFT
                &kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &mo 1  &kp SPACE  &kp RALT  &kp RGUI  &mo 2
            >;
        };
        function_layer {
            display-name = "Function";
            bindings = <
                &kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F11  &kp F12  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp INS
                &trans  &trans  &kp UP  &trans  &sys_reset  &trans  &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans  &trans  &trans  &kp PSCRN  &studio_unlock
                &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &mo 3  &kp C_MUTE  &kp C_PLAY_PAUSE  &haptic_play 1  &haptic_play 7  &haptic_play 10  &haptic_play 14  &kp PG_UP  &kp PG_DN
                &trans  &rgb_ug RGB_TOG  &haptic 1  &haptic 2  &haptic 0  &mo 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
                &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
                &out OUT_TOG  &trans  &trans  &trans  &bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        rgb_layer {
            display-name = "RGB";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        extra1 { display-name = "Extra 1"; status = "reserved"; };
        extra2 { display-name = "Extra 2"; status = "reserved"; };
    };
};
